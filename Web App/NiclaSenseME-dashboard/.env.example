# Copy this file to .env in this same folder. .env is gitignored - never
# commit real credentials.

# Default: local MongoDB Community Server. Leave this line as-is (or omit
# MONGODB_URI entirely) if you installed MongoDB on this machine.
MONGODB_URI=mongodb://localhost:27017

# Only use this if you were able to confirm MongoDB Atlas (port 27017 TLS) is
# NOT blocked on your network - many corporate networks block or intercept it.
# In Atlas: Database > Connect > Drivers > Python, copy the string shown
# there, then replace <username>/<password>.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
